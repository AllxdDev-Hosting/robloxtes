-- Floating Menu Script
local player = game.Players.LocalPlayer
local UIS = game:GetService("UserInputService")

-- SETTINGS
local autoAnswer = false
local speedOn = false
local jumpOn = false
local delayTime = 1

-- ===== UI =====
local gui = Instance.new("ScreenGui", game.CoreGui)
gui.Name = "AllxdDevMenu"

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0,220,0,180)
frame.Position = UDim2.new(0.1,0,0.3,0)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
frame.Active = true
frame.Draggable = true

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1,0,0,30)
title.Text = "AllxdDev Menu"
title.BackgroundColor3 = Color3.fromRGB(40,40,40)
title.TextColor3 = Color3.new(1,1,1)

-- close button
local close = Instance.new("TextButton", frame)
close.Size = UDim2.new(0,30,0,30)
close.Position = UDim2.new(1,-30,0,0)
close.Text = "X"

-- minimize button
local mini = Instance.new("TextButton", frame)
mini.Size = UDim2.new(0,30,0,30)
mini.Position = UDim2.new(1,-60,0,0)
mini.Text = "-"

-- floating logo
local logo = Instance.new("TextButton", gui)
logo.Size = UDim2.new(0,50,0,50)
logo.Position = UDim2.new(0.05,0,0.3,0)
logo.Text = "AXD"
logo.Visible = false
logo.BackgroundColor3 = Color3.fromRGB(40,40,40)
logo.Active = true
logo.Draggable = true

mini.MouseButton1Click:Connect(function()
	frame.Visible = false
	logo.Visible = true
end)

logo.MouseButton1Click:Connect(function()
	frame.Visible = true
	logo.Visible = false
end)

close.MouseButton1Click:Connect(function()
	gui:Destroy()
end)

-- ===== MENU BUTTON =====

local function createToggle(text,y,callback)
	local btn = Instance.new("TextButton", frame)
	btn.Size = UDim2.new(1,-10,0,30)
	btn.Position = UDim2.new(0,5,0,y)
	btn.Text = text.." : OFF"
	btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
	btn.TextColor3 = Color3.new(1,1,1)

	local state=false

	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.Text = text.." : "..(state and "ON" or "OFF")
		callback(state)
	end)
end

createToggle("Jump 2x Higher",40,function(v)
	jumpOn=v
end)

createToggle("Speed 2x",75,function(v)
	speedOn=v
end)

createToggle("Auto Jawab",110,function(v)
	autoAnswer=v
end)

-- delay input
local box = Instance.new("TextBox", frame)
box.Size = UDim2.new(1,-10,0,30)
box.Position = UDim2.new(0,5,0,145)
box.PlaceholderText = "Set Delay (1 = 1 detik)"

box.FocusLost:Connect(function()
	local num = tonumber(box.Text)
	if num then
		delayTime = num
	end
end)

-- ===== DOUBLE JUMP =====
UIS.JumpRequest:Connect(function()
	if jumpOn then
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
end)

-- ===== SPEED =====
game:GetService("RunService").RenderStepped:Connect(function()
	if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
		local hum = player.Character.Humanoid
		if speedOn then
			hum.WalkSpeed = 32
		else
			hum.WalkSpeed = 16
		end
	end
end)

-- ===== AUTO JAWAB (contoh sederhana) =====
local words={"apel","ikan","nasi","api","indah","hutan","naga","anggur"}

task.spawn(function()
	while true do
		task.wait(delayTime)
		if autoAnswer then
			local word = words[math.random(#words)]
			pcall(function()
				game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(word,"All")
			end)
		end
	end
end)
